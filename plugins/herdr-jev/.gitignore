# ---- build output -------------------------------------------------------
bin/
dist/
*.exe

# ---- config and state ---------------------------------------------------
# Real config lives in ~/.config/herdr-jev/. config.example.toml is the only
# config file that belongs in this repo.
config.toml
config.local.toml
*.local.toml
herdr-jev.toml
.env
.env.*
!.env.example
state/

# ---- runtime ------------------------------------------------------------
# The daemon's pidfile, the decision journal, and the hold queue are machine
# state, not source. See SPEC.md §7-§8.
*.pid
*.log
logs/
.herdr-jev/

# ---- tooling ------------------------------------------------------------
*.test
*.out
coverage.*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
